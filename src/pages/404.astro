---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在">
  <div class="wrap">
    <section class="hero">
      <p class="kicker">404</p>
      <h1>这里什么都没有</h1>
      <p>地址可能写错了，或者这篇文章还没写完。</p>
      <p class="link-row" style="margin-top:1.5rem">
        <a href="/">回首页</a>
        <a href="/writing/">去文学栏目</a>
      </p>
    </section>
  </div>
</BaseLayout>
